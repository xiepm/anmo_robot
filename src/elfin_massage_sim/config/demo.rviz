Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Name: Elfin5 L
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/PointStamped
      Name: Surface point
      Enabled: true
      Topic:
        Value: /massage/surface_point
      Color: 255; 80; 80
      Radius: 0.015
    - Class: rviz_default_plugins/PointStamped
      Name: Target point
      Enabled: true
      Topic:
        Value: /massage/target_point
      Color: 80; 255; 80
      Radius: 0.015
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.2
      Focal Point: {X: 0.5, Y: 0.2, Z: 0.35}
      Pitch: 0.65
      Yaw: 0.8
Window Geometry:
  Width: 1050
  Height: 750
